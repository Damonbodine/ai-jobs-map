# Database (Neon Postgres — pooled URL for app runtime, unpooled for migrations/bulk work)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Resend (transactional email)
RESEND_API_KEY=
# Must be a verified sender in Resend. For local dev you can use onboarding@resend.dev.
RESEND_FROM_EMAIL=Timeback <hello@notifications.clearroadlabs.com>

# Site URL (used for metadataBase, canonical URLs, and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3050

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to disable
# analytics entirely (local dev, previews) — lib/analytics.ts no-ops.
NEXT_PUBLIC_GA_ID=
